@model IEnumerable<WebBanHang.Models.Order>
@{
    Layout = "../Shared/_Layout.cshtml";
    ViewBag.Title = "Danh sách hóa đơn";
}

<!-- DataTables CSS -->
<link rel="stylesheet" href="https://cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css">

<!-- jQuery -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<!-- DataTables JS -->
<script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>

<!-- Font Awesome for search icon -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

<div class="page-container">
    <div class="category-header">
        <h2 class="category-title">Danh sách hóa đơn</h2>
    </div>

    <div class="top-actions">
        <div class="row">
            <div class="col-md-4">
                <label for="startDate"><b>Ngày bắt đầu</b></label>
                <input type="date" id="startDate" class="form-control" title="Chọn ngày bắt đầu" />
            </div>
            <div class="col-md-4">
                <label for="endDate"><b>Ngày kết thúc</b></label>
                <input type="date" id="endDate" class="form-control" title="Chọn ngày kết thúc" />
            </div>
            <div class="col-md-4">
                <br />
                <button id="btnThongKe" class="btn btn-primary custom-btn">📊 Thống Kê</button>
                <a href="@Url.Action("ExportToExcel", "HoaDon", new { area = "Admin", startDate = ViewBag.StartDate, endDate = ViewBag.EndDate })" class="btn btn-success custom-btn">Xuất Excel</a>
            </div>
        </div>
        <div class="search-container">
            <input type="text" id="searchBox" placeholder="Search" onkeyup="searchHoaDon()">
            <button class="search-btn">
                <i class="fas fa-search"></i>
            </button>
        </div>
    </div>

    <div id="customControls" style="display: flex; align-items: center; gap: 10px;">
        <div id="dataTables_length"></div>
        <button id="sortButton" type="button" class="btn btn-primary sort-btn">
            <svg id="sortIcon" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M7 10l5-5 5 5H7zm0 4h10l-5 5-5-5z" />
            </svg>
            Sort
        </button>
    </div>

    <table class="table table-bordered table-striped category-table" id="hoaDonTable">
        <thead class="thead-dark">
            <tr>
                <th>Mã Hóa Đơn</th>
                <th>Mã Người Dùng</th>
                <th>Ngày Đặt Hàng</th>
                <th>Tổng Tiền</th>
                <th>Phương Thức Thanh Toán</th>
                <th>Trạng Thái</th>
                <th>Chi Tiết</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.OrderId</td>
                    <td>@item.UserId</td>
                    <td>@item.OrderDate.ToString("dd/MM/yyyy")</td>
                    <td>@item.TotalAmount</td>
                    <td>@(item.PhuongThucThanhToan?.TenPhuongThuc ?? "N/A")</td>
                    <td>@item.StatusId</td>
                    <td>
                        <button class="btn btn-info btnChiTiet" data-id="@item.OrderId">Xem chi tiết</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script>
    $(document).ready(function () {
        var table = $('#hoaDonTable').DataTable({
            "paging": true, // Bật phân trang
            "lengthMenu": [5, 10, 25, 50, -1],
            "lengthChange": true,
            "pageLength": 10,
            "ordering": true,
            "info": true,
            "searching": false,
            "destroy": true,
            "columnDefs": [
                { "orderable": false, "targets": [0, 1, 3, 4, 5, 6] },
            ],
            "language": {
                "lengthMenu": "Hiển thị _MENU_ bản ghi",
                "zeroRecords": "Không tìm thấy hóa đơn nào",
                "info": "Hiển thị _START_ đến _END_ trong tổng số _TOTAL_ hóa đơn",
                "infoEmpty": "Không có dữ liệu để hiển thị",
                "infoFiltered": "(lọc từ _MAX_ hóa đơn)",
                "paginate": {
                    "first": "Đầu",
                    "last": "Cuối",
                    "next": "Tiếp",
                    "previous": "Trước"
                }
            },
            "drawCallback": function () {
                $("#hoaDonTable_length").appendTo("#dataTables_length");
            }
        });

        var sortDirection = 'asc';
        $("#sortButton").on("click", function () {
            let icon = $("#sortIcon");
            table.order([2, sortDirection]).draw();
            sortDirection = (sortDirection === 'asc') ? 'desc' : 'asc';
            icon.html(sortDirection === "asc"
                ? '<path d="M7 10l5-5 5 5H7zm0 4h10l-5 5-5-5z"/>'
                : '<path d="M7 14l5 5 5-5H7zm0-4h10l-5-5-5 5z"/>'
            );
        });

        $('#hoaDonTable tbody').on('click', '.btnChiTiet', function () {
            var tr = $(this).closest('tr');
            var orderId = $(this).data('id');
            if (tr.hasClass('shown')) {
                tr.nextUntil(':not(.detail-header, .detail-row)').remove();
                tr.removeClass('shown');
            } else {
                var url = "@Url.Action("ChiTietHoaDon", "HoaDon", new { area = "Admin" })";
                $.ajax({
                    url: url,
                    type: "GET",
                    data: { orderId: orderId },
                    success: function (data) {
                        if (data && data.trim() !== '' && !data.includes('Lỗi')) {
                            $(data).insertAfter(tr);
                            tr.addClass('shown');
                        } else {
                            var errorRow = '<tr class="detail-header"><td colspan="7" style="color: red; text-align: center;">⚠️ Không có chi tiết hoặc lỗi khi tải dữ liệu</td></tr>';
                            $(errorRow).insertAfter(tr);
                            tr.addClass('shown');
                        }
                    },
                    error: function () {
                        var errorRow = '<tr class="detail-header"><td colspan="7" style="color: red; text-align: center;">⚠️ Lỗi khi tải dữ liệu!</td></tr>';
                        $(errorRow).insertAfter(tr);
                        tr.addClass('shown');
                    }
                });
            }
        });

        $("#btnThongKe").click(function () {
            var start = $("#startDate").val();
            var end = $("#endDate").val();
            $.ajax({
                url: "@Url.Action("HoaDon", "HoaDon", new { area = "Admin" })",
                type: "GET",
                data: { startDate: start, endDate: end },
                success: function (data) {
                    table.clear().draw();
                    table.rows.add($(data)).draw();
                },
                error: function () {
                    table.clear().draw();
                    table.rows.add($('<tr><td colspan="7" style="color: red;">⚠️ Lỗi khi tải dữ liệu!</td></tr>')).draw();
                }
            });
        });
    });

    function searchHoaDon() {
        var input = document.getElementById("searchBox");
        var filter = input.value.toUpperCase();
        var table = document.getElementById("hoaDonTable");
        var tr = table.getElementsByTagName("tr");

        for (var i = 1; i < tr.length; i++) {
            if (tr[i].classList.contains('detail-header') || tr[i].classList.contains('detail-row')) continue;
            var tdArray = tr[i].getElementsByTagName("td");
            let found = false;
            for (let td of tdArray) {
                if (td) {
                    var txtValue = td.textContent || td.innerText;
                    if (txtValue.toUpperCase().indexOf(filter) > -1) {
                        found = true;
                        break;
                    }
                }
            }
            tr[i].style.display = found ? "" : "none";
        }
    }
</script>

<style>
    .dataTables_wrapper th,
    .dataTables_wrapper td {
        border: 1px solid #ddd !important;
    }

    table {
        width: 100%;
        table-layout: auto;
        border-collapse: collapse;
        border: none !important;
    }

    #customControls {
        display: flex;
        align-items: center;
        margin-bottom: 5px;
        gap: 10px;
    }

    #dataTables_length select {
        height: 40px;
        padding: 8px 16px;
        font-size: 16px;
        border-radius: 8px;
        border: 1px solid #ccc;
        background-color: white;
        cursor: pointer;
    }

    .sort-btn {
        display: flex;
        align-items: center;
        gap: 8px;
        background-color: #f3e8ff;
        color: #7c3aed;
        font-weight: bold;
        padding: 8px 16px;
        border-radius: 8px;
        border: none;
        cursor: pointer;
        transition: background 0.3s;
        height: 40px;
    }

        .sort-btn:hover {
            background-color: #e9d5ff;
        }

    #sortIcon {
        width: 16px;
        height: 16px;
    }

    .dataTables_wrapper th {
        pointer-events: none;
    }

        .dataTables_wrapper th::after,
        .dataTables_wrapper th::before {
            display: none !important;
        }

    .category-header {
        background-color: #fff;
        padding: 20px 30px;
        border-radius: 0 25px 25px 0;
        margin-bottom: 20px;
    }

    .category-title {
        font-size: 24px;
        font-weight: bold;
        margin: 0;
    }

    .top-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
    }

    .search-container {
        position: relative;
        width: 250px;
    }

        .search-container input {
            width: 100%;
            padding: 8px 35px 8px 10px;
            border-radius: 5px;
            border: 1px solid #ccc;
            outline: none;
        }

    .search-btn {
        position: absolute;
        right: 5px;
        top: 50%;
        transform: translateY(-50%);
        background-color: transparent;
        border: none;
        cursor: pointer;
        color: #007bff;
        font-size: 16px;
    }

    .category-table th, .category-table td {
        padding: 4px 8px;
        border: 1px solid #ddd;
        text-align: center;
        white-space: nowrap;
    }

    table td {
        vertical-align: middle !important;
        text-align: center;
    }

    .table td:last-child {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 5px;
    }

    th:last-child, td:last-child {
        min-width: 140px;
        text-align: center;
    }

    td.action-buttons {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
        height: 100%;
    }

        td.action-buttons a {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 45px;
            height: 45px;
            border-radius: 5px;
        }

    td {
        vertical-align: middle !important;
    }

    .btn-info {
        padding: 6px 12px;
        border-radius: 5px;
        font-size: 14px;
        font-weight: bold;
        border: none;
        cursor: pointer;
        width: 120px;
        height: 40px;
        background-color: #17a2b8;
        color: white;
    }

        .btn-info:hover {
            background-color: #138496;
        }

    .custom-btn {
        padding: 8px 16px;
        border-radius: 5px;
        font-size: 14px;
        font-weight: bold;
        border: none;
        cursor: pointer;
        height: 38px;
        margin-left: 5px;
    }

    .btn-primary.custom-btn {
        background-color: #007bff;
        color: white;
    }

        .btn-primary.custom-btn:hover {
            background-color: #0056b3;
        }

    .btn-success.custom-btn {
        background-color: #28a745;
        color: white;
        position: absolute;
        bottom: 10px;
        right: 10px;
    }

        .btn-success.custom-btn:hover {
            background-color: #218838;
        }

    .dataTables_paginate {
        margin-top: 10px;
        text-align: right;
    }

        .dataTables_paginate .paginate_button {
            padding: 5px 10px;
            margin: 0 2px;
            border: 1px solid #ddd;
            border-radius: 3px;
            cursor: pointer;
        }

            .dataTables_paginate .paginate_button.current {
                background-color: #007bff;
                color: white;
                border: 1px solid #007bff;
            }

            .dataTables_paginate .paginate_button:hover {
                background-color: #e9ecef;
            }

    /* Đảm bảo nút Xuất Excel không bị che bởi các phần tử khác */
    .page-container {
        position: relative;
        padding-bottom: 50px; /* Tạo khoảng trống để nút Xuất Excel hiển thị */
    }
</style>
@model List<WebBanHang.Models.BanChayModel>

@{
    Layout = "../Shared/_Layout.cshtml";
    ViewBag.Title = "Sản phẩm bán chạy";
}

<h2 class="text-center">SẢN PHẨM BÁN CHẠY</h2>

<div class="product-list">
    @if (Model != null && Model.Any())
    {
        foreach (var item in Model)
        {
            <div class="product-card">
                <img src="@item.ImageUrl" alt="@item.FoodName">
                <h5>@item.FoodName</h5>
                <p class="price">@item.Price.ToString("N0")đ</p>
                <p class="sold">Đã bán: @item.TotalSold</p>
                <a href="@Url.Action("Info", "SanPhamAdmin", new { id = item.FoodId })" class="btn-buy">
                    Xem chi tiết
                </a>
            </div>
        }
    }
    else
    {
        <p class="text-center text-danger">Không có dữ liệu</p>
    }
</div>

<style>
    /* Căn giữa danh sách sản phẩm */
    .product-list {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 20px;
    }

    /* Card sản phẩm */
    .product-card {
        background-color: #fff;
        border: 1px solid #ddd;
        padding: 15px;
        width: 260px;
        border-radius: 10px;
        transition: all 0.3s ease-in-out;
        display: flex;
        flex-direction: column;
        align-items: flex-start; /* Căn trái toàn bộ nội dung */
        text-align: left; /* Chữ căn trái */
        align-items: flex-start; /* Căn trái toàn bộ nội dung */
        text-align: left; /* Chữ căn trái */
        box-shadow: 2px 2px 10px rgba(0, 0, 0, 0.1);
    }

        /* Hiệu ứng hover */
        .product-card:hover {
            transform: scale(1.05);
            box-shadow: 4px 4px 15px rgba(0, 0, 0, 0.15);
        }

        /* Ảnh sản phẩm */
        .product-card img {
            width: 100%;
            height: 240px;
            object-fit: cover;
            border-radius: 10px;
        }

        /* Tên sản phẩm */
        .product-card h5 {
            font-size: 16px;
            color: #333;
            margin: 10px 0 5px;
        }

        /* Giá */
        .product-card .price {
            color: #d8804b;
            font-weight: bold;
            font-size: 16px;
            margin: 10px 0 5px;
        }

        /* Đã bán */
        .product-card .sold {
            color: #666;
            font-size: 14px;
            margin: 10px 0 5px;
        }

        /* Button */
        .product-card .btn-buy {
            background: #e5d1c0;
            color: #3a3a3a;
            border: none;
            padding: 8px 25px;
            font-weight: bold;
            cursor: pointer;
            transition: background 0.3s;
            border-radius: 5px;
            font-size: 13px;
            text-transform: uppercase;
            margin: 10px 0 5px;
            margin-top: 10px;
        }

            /* Hover */
            .product-card .btn-buy:hover {
                background: #d3b49e;
            }
</style>

@model IEnumerable<WebBanHang.Models.Food>

@{
    Layout = "../Shared/_Layout.cshtml";
}
<link href="~/Content/SanPhamAdmin.css" rel="stylesheet" />

<div class="page-container">
    <div class="header-container">
        <h2>Danh sách món ăn</h2>
        <a href="@Url.Action("Add", "SanPhamAdmin")" class="btn-add">➕ Thêm món ăn mới</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (!string.IsNullOrEmpty(TempData["ErrorMessage"] as string))
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <p class="alert alert-warning">Không có món ăn nào để hiển thị.</p>
    }
    else
    {
        <div class="product-container">
            @foreach (var item in Model)
            {
                <div class="product-card">
                    @if (item.Discount > 0)
                    {
                        <div class="discount">-@item.Discount%</div>
                    }
                    <img src="@(!string.IsNullOrEmpty(item.ImageURL) ? Url.Content(item.ImageURL) : "/Content/Images/no-image.png")" alt="@item.FoodName" />
                    <h4 class="product-title">@item.FoodName</h4>
                    <p class="price">
                        @string.Format("{0:N0}", item.Price) đ
                        @if (item.DiscountPrice > 0)
                        {
                            <span class="old-price">@string.Format("{0:N0}", item.DiscountPrice) đ</span>
                        }
                    </p>
                    <p><strong>Trạng thái:</strong> @(item.Status == true ? "Còn bán" : "Ngừng bán")</p>
                    <div class="button-group">
                        <a href="@Url.Action("Edit", "SanPhamAdmin", new { id = item.FoodId })" class="btn-edit">📝 Sửa</a>
                        <a href="@Url.Action("Delete", "SanPhamAdmin", new { id = item.FoodId })" class="btn-delete" onclick="return confirm('Bạn có chắc chắn muốn xóa món ăn này không?');">❌ Xóa</a>
                    </div>
                </div>
            }
        </div>
    }
</div>
<style>
    .product-container {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        justify-content: center;
    }

    .price {
        font-size: 16px;
        font-weight: bold;
        color: #d8804b; /* Đổi màu giá thành */
        margin-top: 3px;
    }

    .old-price {
        font-size: 14px;
        text-decoration: line-through;
        color: #b89a86; /* Màu nhẹ hơn cho giá cũ */
        margin-left: 5px;
    }

    .product-card {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: flex-start; /* Căn trái tất cả nội dung */
        height: auto;
        width: 260px;
        padding: 12px;
        border: 1px solid #ddd;
        border-radius: 10px;
        background-color: #fff;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
        text-align: left; /* Căn trái nội dung */
    }

        .product-card img {
            width: 100%;
            height: 180px;
            object-fit: cover;
            border-radius: 8px;
            margin-bottom: 5px; /* Giảm khoảng cách với tên nguyên liệu */
        }

    .product-title {
        font-size: 16px;
        font-weight: bold;
        margin: 2px 0; /* Thu hẹp khoảng cách giữa tên và số lượng */
        line-height: 1.2;
    }

    .product-info {
        font-size: 14px;
        line-height: 1.1;
        margin-top: -3px; /* Kéo lên gần với tên nguyên liệu */
        text-align: left; /* Căn trái thông tin */
        width: 100%;
    }

    .alert-warning {
        font-size: 13px;
        padding: 5px 8px;
        background-color: #fff3cd;
        color: #856404;
        border: 1px solid #ffeeba;
        border-radius: 5px;
        text-align: left;
        margin-top: 5px;
        width: 100%;
    }

    .button-group {
        display: flex;
        justify-content: space-between;
        width: 100%;
        margin-top: auto;
    }

    .btn-edit, .btn-delete {
        display: inline-block;
        padding: 6px 10px;
        border-radius: 5px;
        text-decoration: none;
        font-weight: bold;
        text-align: center;
        width: 48%;
        background-color: #d3b49e; /* Đổi màu nút */
        color: white;
        border: none;
    }

        .btn-edit:hover, .btn-delete:hover {
            background-color: #b89a86; /* Màu hover nhẹ hơn */
        }
</style>

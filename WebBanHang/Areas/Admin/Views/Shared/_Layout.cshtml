@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin Area - SuLi Coffee</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet" />
    <link href="@Url.Content("~/Content/Admin.css")" rel="stylesheet" />
    @RenderSection("Styles", required: false)
</head>
<body>
    <header class="header d-flex align-items-center bg-dark text-white py-3">
        <div class="container d-flex align-items-center justify-content-between">
            <div class="logo">
                <a href="@Url.Action("HomeAdmin", "HomeAdmin", new { area = "Admin" })" class="text-white text-decoration-none fs-4">SuLi Admin</a>
            </div>
            <nav class="nav">
                <ul class="d-flex list-unstyled mb-0 gap-4">
                    <li><a class="text-white text-decoration-none" href="@Url.Action("Info", "SanPhamAdmin", new { area = "Admin" })">Quản lý sản phẩm</a></li>
                    <li><a class="text-white text-decoration-none" href="@Url.Action("Index", "UserAdmin", new { area = "Admin" })">Quản lý người dùng</a></li>
                    <li><a class="text-white text-decoration-none" href="@Url.Action("Logout", "Login", new { area = "" })">Đăng xuất</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <main class="container mt-4">
        @RenderBody()
    </main>

    <footer class="footer bg-dark text-white text-center py-3 mt-5">
        <p>©2025 Bản quyền Admin SuLi Coffee</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>

@model WebBanHang.Models.Category

<h2>Chỉnh sửa danh mục</h2>
<hr />

<div class="container">
    @using (Html.BeginForm("Edit", "DanhMucSP", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.CategoryId) <!-- Ẩn ID danh mục -->

        <div class="form-group">
            <label for="CategoryName">Tên danh mục:</label>
            @Html.TextBoxFor(model => model.CategoryName, new { @class = "form-control", id = "CategoryName", placeholder = "Nhập tên danh mục" })
        </div>

        <button type="submit" class="btn btn-primary mt-3">Lưu thay đổi</button>
        <a href="@Url.Action("DanhMucSP", "DanhMucSP")" class="btn btn-secondary mt-3">Hủy</a>
    }
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success mt-3">
        @TempData["SuccessMessage"]
    </div>
}

@if (!string.IsNullOrEmpty(TempData["ErrorMessage"] as string))
{
    <div class="alert alert-danger mt-3">
        @TempData["ErrorMessage"]
    </div>
}

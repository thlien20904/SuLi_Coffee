@model IEnumerable<WebBanHang.Models.Food>
@{
    ViewBag.Title = "Danh sách món ăn";
}
<link rel="stylesheet" href="~/Content/SanPham.css" />
<!-- Banner Section with Bootstrap Carousel -->
<section class="banner">
    <div id="carouselBanner" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">
            <!-- Slide 1: Video -->
            <div class="carousel-item active">
                <!-- THÊM active vào đây -->
                <video autoplay muted loop class="d-block w-100 banner-video">
                    <source src="@Url.Content("~/video/vd6.mp4")" type="video/mp4" />
                    Your browser does not support the video tag.
                </video>
            </div>
        </div>
        <!-- Controls -->
        <button class="carousel-control-prev" type="button" data-bs-target="#carouselBanner" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#carouselBanner" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>
</section>
<h2 style="margin: 20px 0;">Danh sách món ăn</h2>

@if (Model != null && Model.Any())
{
    <div class="product-container">
        @foreach (var item in Model)
        {
            <div class="product-card">
                @*<img src="@Url.Content("~/images/" + item.ImageURL)" alt="@item.FoodName" />*@
                <img src="@Url.Content(item.ImageURL)" alt="@item.FoodName" />
                <h4 class="product-title">@item.FoodName</h4>
                <p class="price">@String.Format("{0:N0} ₫", item.Price)</p>
            </div>
        }
    </div>
}
else
{
    <p>Không có sản phẩm nào để hiển thị.</p>
}

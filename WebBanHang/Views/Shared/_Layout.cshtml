<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Suli Coffee - Trang chủ</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link href="@Url.Content("~/Content/GT.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Content/Lienhe.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Content/Thethanhvien.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Content/Home.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Content/SanPham.css")" rel="stylesheet" />

    <style>
        /* CSS cho menu con */
        .nav .menu-item {
            position: relative;
            padding: 10px 20px;
        }

            .nav .menu-item:hover .submenu {
                display: block;
            }
        .nav ul {
            display: flex;
            gap: 20px;
            list-style: none;
            padding: 0;
            margin: 0;
            align-items: center; /* Căn giữa theo chiều dọc */
        }

        .nav .menu-item {
            position: relative;
            padding: 0 20px; /* Chỉnh padding để không bị lệch */
            display: inline-block;
            line-height: 60px; /* Đảm bảo chiều cao đồng nhất */
        }

        .nav a {
            color: white;
            text-decoration: none;
            font-weight: bold;
        }

            .nav a:hover {
                color: #ff6600;
                text-decoration: underline;
            }
        .submenu {
            display: none;
            position: absolute;
            top: 100%;
            left: 50%;
            transform: translateX(-50%);
            background-color: white;
            padding: 15px 20px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            white-space: nowrap;
            z-index: 1000;
        }

        .submenu-column {
            padding: 10px;
            display: inline-block;
            vertical-align: top;
        }

            .submenu-column h4 {
                font-weight: bold;
                margin-bottom: 8px;
                text-decoration: underline;
            }

            .submenu-column p {
                margin: 5px 0;
                cursor: pointer;
            }

                .submenu-column p:hover {
                    color: #ff6600;
                }

        .menu-item:hover a {
            text-decoration: underline;
        }
    </style>

    @RenderSection("Styles", required: false)
</head>
<body>
    <header class="header d-flex align-items-center">
        <div class="logo" style="padding-left: 20px;">
            <a href="@Url.Action("Home", "Home")" class="logo-link text-decoration-none d-block">
                <div class="logo-middle" style="font-family: 'Great Vibes', cursive; font-size: 32px;">SuLi Coffee</div>
            </a>
        </div>

        <div class="container d-flex align-items-center justify-content-between flex-grow-1">
            <div class="search-bar mx-4" style="flex: 1; max-width: 300px;">
                <form action="@Url.Action("Search", "SanPham")" method="get" class="d-flex">
                    <input type="text" name="query" class="form-control" placeholder="Tìm kiếm sản phẩm...">
                    <button type="submit" class="btn btn-dark ms-2"><i class="fas fa-search"></i></button>
                </form>
            </div>

            <!-- Menu -->
            <nav class="nav">
                <ul class="d-flex list-unstyled mb-0">
                    <li><a href="@Url.Action("Home", "Home")">Trang chủ</a></li>
                    <li class="menu-item">
                        <a href="@Url.Action("SanPham", "SanPham")">Sản phẩm</a>
                        <!-- Submenu -->
                        <div class="submenu">
                            <div class="submenu-column">
                                <h4>Tất Cả</h4>
                                <p><a href="@Url.Action("SanPham", "SanPham")">Sản phẩm</a></p>
                            </div>

                            <div class="submenu-column">
                                <h4>Cà Phê</h4>
                                <p> Cà Phê </p>

                            </div>
                            <div class="submenu-column">
                                <h4>Trà Sữa</h4>
                                <p> Trà Sữa </p>
                            </div> 
                            <div class="submenu-column">
                                <h4>Thức uống đá xay </h4>
                                <p>Thức uống đá xay</p>
                            </div>
                            <div class="submenu-column">
                                <h4>Bánh & Snack</h4>
                                <p> Bánh </p>
                                <p> Snack </p>
                            </div>
                            <div class="submenu-column">
                                <h4>Trà trái cây</h4>
                                <p>Trà trái cây</p>
                            </div>
                        </div>
                    </li>
                    <li><a href="@Url.Action("Index", "GT")">Giới thiệu</a></li>
                    <li><a href="@Url.Action("Index", "Lienhe")">Liên hệ</a></li>
                    <li><a href="@Url.Action("Thethanhvien", "Thethanhvien")">Thẻ thành viên</a></li>
                    @if (Session["Username"] == null)
                    {
                        <li><a href="@Url.Action("Login", "Login")">Đăng nhập</a></li>
                    }
                    else
                    {
                        <li class="user-info">Xin chào, @Session["Username"]</li>
                        <li><a href="@Url.Action("Logout", "Login")">Đăng xuất</a></li>
                    }
                </ul>
            </nav>
        </div>
    </header>

    <main class="main-content">
        @RenderBody()
    </main>
    <footer class="footer" style="background-color: black; color: white; padding: 20px 0;">
        <div class="container">
            <div class="text-center" style="border-top: 1px solid white; padding-top: 40px;">
                <p>©2025 Bản quyền này thuộc về Công Ty Cổ Phần SuLi</p>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>

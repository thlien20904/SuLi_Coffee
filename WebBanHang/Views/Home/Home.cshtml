        </div>
        <div class="product-card">
            <img src="@Url.Content("~/images/cafe3.png")" alt="Ca cao nóng" />
            <h3>CA CAO NÓNG</h3>
            <p class="price">40.000₫</p>
            <button>CHI TIẾT</button>
        </div>
        <div class="product-card">
            <img src="@Url.Content("~/images/noibat.png")" alt="Lụa đào" />

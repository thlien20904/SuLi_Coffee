@model List<WebBanHang.Models.GioHang>
@{
    ViewBag.Title = "Giỏ hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="@Url.Content("~/Content/GioHang.css")" rel="stylesheet" />
<div style="margin-top: 100px;">
    <h2 class="text-center cart-title">Giỏ hàng của bạn</h2>
</div>

<div id="cart-empty-message" class="alert alert-warning text-center" style="@(Model == null || !Model.Any() ? "" : "display: none;")">
    <h4>Giỏ hàng của bạn đang trống!</h4>
    <a href="@Url.Action("SanPham", "SanPham")" class="btn btn-primary mt-3">Tiếp tục mua sắm</a>
</div>

@if (Model != null && Model.Any())
{
    <div id="cart-content">
        <table id="cart-table" class="table table-bordered table-striped text-center">
            <thead class="table-dark">
                <tr>
                    <th>
                        <input type="checkbox" id="select-all" /> Chọn
                    </th>
                    <th>Hình ảnh</th>
                    <th>Tên sản phẩm</th>
                    <th>Size</th>
                    <th>Topping</th>
                    <th>Đơn giá</th>
                    <th>Số lượng</th>
                    <th>Thành tiền</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var toppingIds = item.GioHang_Topping.Select(gt => gt.Topping.ToppingID).ToList();
                    var toppingIdsJson = Newtonsoft.Json.JsonConvert.SerializeObject(toppingIds);

                    <tr data-toppingids='@toppingIdsJson'>
                        <td>
                            <input type="checkbox" class="select-item"
                                   data-giohangid="@item.GioHangID"
                                   data-totalprice="@item.TotalPrice" />
                        </td>
                        <td>
                            <img src="@(string.IsNullOrEmpty(item.Food.ImageURL) ? Url.Content("~/images/no-image.png") : Url.Content(item.Food.ImageURL))"
                                 alt="Ảnh sản phẩm" class="img-thumbnail" style="width: 100px; height: 100px;" />
                        </td>
                        <td>@item.Food.FoodName</td>
                        <td>
                            @if (item.Size != null)
                            {
                                <p>@item.Size.SizeName (+@String.Format("{0:N0} ₫", item.Size.ExtraPrice))</p>
                            }
                            else
                            {
                                <p>Không có</p>
                            }
                        </td>
                        <td>
                            @if (item.GioHang_Topping.Any())
                            {
                                foreach (var topping in item.GioHang_Topping)
                                {
                                    <p>@topping.Topping.ToppingName (+@String.Format("{0:N0} ₫", topping.Topping.ToppingPrice))</p>
                                }
                            }
                            else
                            {
                                <p>Không có</p>
                            }
                        </td>
                        <td>@String.Format("{0:N0} ₫", item.Food.Price)</td>
                        <td>
                            <input type="number" min="1" value="@item.SoLuong" class="soLuongInput"
                                   data-foodid="@item.FoodId" data-sizeid="@(item.SizeID.HasValue ? item.SizeID.Value.ToString() : "0")" style="width: 60px; display: inline-block; ">
                        </td>
                        <td class="total-price">@String.Format("{0:N0} ₫", item.TotalPrice)</td>
                        <td>
                            <a href="#" class="btn btn-danger btn-sm btn-xoa"
                               data-foodid="@item.Food.FoodId"
                               data-sizeid="@(item.SizeID.HasValue ? item.SizeID.Value.ToString() : "0")">
                                Xóa
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <h4 id="total-price"><strong>Tổng tiền: 0 ₫</strong></h4>
        <div class="text-right" id="cart-actions">
            <a href="@Url.Action("SanPham", "SanPham")" class="btn btn-secondary">Tiếp tục mua sắm</a>
            <a href="#" id="btn-thanh-toan" class="btn btn-success">Thanh toán</a>
        </div>
    </div>
}

@section scripts {
    <script>
        function updateSelectedTotal() {
            var total = 0;
            document.querySelectorAll(".select-item:checked").forEach(checkbox => {
                var totalPrice = parseFloat(checkbox.getAttribute("data-totalprice"));
                total += totalPrice;
            });
            var totalPriceElement = document.getElementById("total-price");
            totalPriceElement.innerHTML = "<strong>Tổng tiền: " + total.toLocaleString("vi-VN") + " ₫</strong>";
        }

        document.getElementById("select-all").addEventListener("change", function () {
            var isChecked = this.checked;
            document.querySelectorAll(".select-item").forEach(checkbox => {
                checkbox.checked = isChecked;
            });
            updateSelectedTotal();
        });

        document.querySelectorAll(".select-item").forEach(checkbox => {
            checkbox.addEventListener("change", function () {
                var allCheckboxes = document.querySelectorAll(".select-item");
                var checkedCheckboxes = document.querySelectorAll(".select-item:checked");
                document.getElementById("select-all").checked = allCheckboxes.length === checkedCheckboxes.length;
                updateSelectedTotal();
            });
        });

        document.getElementById("btn-thanh-toan").addEventListener("click", function (e) {
            e.preventDefault();
            var selectedItems = [];
            document.querySelectorAll(".select-item:checked").forEach(checkbox => {
                var gioHangId = parseInt(checkbox.getAttribute("data-giohangid"));
                selectedItems.push(gioHangId);
            });

            if (selectedItems.length === 0) {
                alert("Vui lòng chọn ít nhất một sản phẩm để thanh toán!");
                return;
            }

            fetch('/ThanhToan/PrepareCheckout', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ selectedItems: selectedItems })
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        window.location.href = '@Url.Action("ThanhToan", "ThanhToan")';
                    } else {
                        alert(data.message || "Có lỗi xảy ra khi chuẩn bị thanh toán!");
                    }
                })
                .catch(error => {
                    console.error("Lỗi Fetch:", error);
                    alert("Có lỗi xảy ra khi chuẩn bị thanh toán!");
                });
        });

        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll(".select-item").forEach(checkbox => {
                checkbox.checked = true;
            });
            document.getElementById("select-all").checked = true;
            updateSelectedTotal();

            fetch('/GioHang/GetCartCount', {
                method: 'GET',
                headers: { 'Content-Type': 'application/json' }
            })
            .then(response => response.json())
            .then(data => {
                if (data.cartCount !== undefined) {
                    updateCartCount(data.cartCount);
                }
            })
            .catch(error => {
                console.error("Lỗi khi lấy số lượng giỏ hàng:", error);
            });
        });

        function updateCartCount(count) {
            var cartCountElement = document.querySelector(".cart-count");
            if (cartCountElement) {
                cartCountElement.textContent = count > 0 ? count : "";
                cartCountElement.style.display = count > 0 ? "inline-block" : "none";
            }
        }

        document.querySelectorAll(".btn-xoa").forEach(button => {
            button.addEventListener("click", function (e) {
                e.preventDefault();
                var productId = this.getAttribute("data-foodid");
                var sizeId = this.getAttribute("data-sizeid");
                var toppingIds = JSON.parse(this.closest("tr").getAttribute("data-toppingids"));

                if (!productId || productId <= 0) {
                    alert("Lỗi: Không tìm thấy ID sản phẩm!");
                    return;
                }

                if (sizeId === "0" || sizeId === "null") {
                    sizeId = null;
                }

                if (confirm("Bạn có chắc muốn xóa sản phẩm này?")) {
                    fetch('/GioHang/XoaKhoiGio', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ foodId: parseInt(productId), sizeId: sizeId ? parseInt(sizeId) : null, toppingIds: toppingIds })
                    })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                if (data.cartCount !== undefined) {
                                    updateCartCount(data.cartCount);
                                }

                                this.closest("tr").remove();

                                if (document.querySelectorAll("#cart-table tbody tr").length === 0) {
                                    document.getElementById("cart-content").style.display = "none";
                                    document.getElementById("cart-empty-message").style.display = "block";
                                }

                                updateSelectedTotal();
                            } else {
                                alert(data.message);
                            }
                        })
                        .catch(error => {
                            console.error("Lỗi Fetch:", error);
                            alert("Có lỗi xảy ra khi xóa sản phẩm!");
                        });
                }
            });
        });

        document.querySelectorAll(".soLuongInput").forEach(input => {
            input.addEventListener("change", function () {
                var foodId = this.getAttribute("data-foodid");
                var sizeId = this.getAttribute("data-sizeid");
                var soLuong = parseInt(this.value);
                var toppingIds = JSON.parse(this.closest("tr").getAttribute("data-toppingids"));
                var inputElement = this;

                if (isNaN(soLuong) || soLuong < 1) {
                    alert("Số lượng phải lớn hơn 0!");
                    inputElement.value = 1;
                    return;
                }

                if (sizeId === "0" || sizeId === "null" || !sizeId) {
                    sizeId = null;
                }

                if (!foodId || foodId <= 0) {
                    alert("Lỗi: Không tìm thấy ID sản phẩm!");
                    inputElement.value = 1;
                    return;
                }

                inputElement.disabled = true;

                fetch('/GioHang/CapNhatSoLuong', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ foodId: parseInt(foodId), sizeId: sizeId ? parseInt(sizeId) : null, soLuong: soLuong, toppingIds: toppingIds })
                })
                    .then(response => {
                        if (!response.ok) {
                            throw new Error("Lỗi khi gọi API: " + response.statusText);
                        }
                        return response.json();
                    })
                    .then(data => {
                        if (data.success) {
                            if (data.cartCount !== undefined) {
                                updateCartCount(data.cartCount);
                            }

                            var totalPriceCell = inputElement.closest("tr").querySelector(".total-price");
                            if (totalPriceCell && typeof data.newItemTotal === "number") {
                                totalPriceCell.textContent = data.newItemTotal.toLocaleString("vi-VN") + " ₫";
                                var checkbox = inputElement.closest("tr").querySelector(".select-item");
                                if (checkbox) {
                                    checkbox.setAttribute("data-totalprice", data.newItemTotal);
                                }
                            }

                            updateSelectedTotal();
                        } else {
                            alert(data.message || "Lỗi: Không thể cập nhật số lượng!");
                            inputElement.value = data.currentQuantity || 1;
                        }
                    })
                    .catch(error => {
                        console.error("Lỗi Fetch:", error);
                        alert("Có lỗi xảy ra khi cập nhật số lượng! Vui lòng thử lại.");
                        inputElement.value = 1;
                    })
                    .finally(() => {
                        inputElement.disabled = false;
                    });
            });
        });
    </script>
}
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Banner Section with Bootstrap Carousel -->
<section class="banner">
    <div id="carouselBanner" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">
            <!-- Slide 1: Video -->
            <div class="carousel-item active">
                <!-- THÊM active vào đây -->
                <video autoplay muted loop class="d-block w-100 banner-video">
                    <source src="@Url.Content("~/video/vd6.mp4")" type="video/mp4" />
                    Your browser does not support the video tag.
                </video>
            </div>
            <!-- Slide 2: Video -->
            <div class="carousel-item">
                <video autoplay muted loop class="d-block w-100 banner-video">
                    <source src="@Url.Content("~/video/vd9.mp4")" type="video/mp4" />
                    Your browser does not support the video tag.
                </video>
            </div>
        </div>
        <!-- Controls -->
        <button class="carousel-control-prev" type="button" data-bs-target="#carouselBanner" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#carouselBanner" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>
</section>
<div style="max-width: 1000px; margin: 0 auto; font-family: Arial, sans-serif; padding: 20px;">
    <h2 style="font-weight: bold; color: #000;">SULI – NỐT HƯƠNG ĐẶC SẢN</h2>

    <div style="margin-top: 20px;">
        <p><img src="https://cdn-icons-png.flaticon.com/512/854/854894.png" width="20" style="vertical-align: middle; margin-right: 8px;" /> <strong>Địa chỉ:</strong></p>
        <ul style="list-style: none; padding-left: 20px;color: #000">
            <li>Trụ sở chính: 273 Trần Đăng Ninh, Phường Dịch Vọng Hậu, Quận Cầu Giấy, TP Hà Nội</li>
            <li>Chi nhánh Đà Lạt: 7 Nguyễn Chí Thanh, phường 1, Thành phố Đà Lạt, tỉnh Lâm Đồng</li>
            <li>Chi nhánh Hà Nội: Lô 04-9A Khu công nghiệp Vĩnh Hoàng, phường Hoàng Văn Thụ, quận Hoàng Mai, Hà Nội</li>
        </ul>
        <p style="color: #000;">
            <img src="https://cdn-icons-png.flaticon.com/512/724/724664.png" width="20" style="vertical-align: middle; margin-right: 8px;" />
            <strong>Hotline:</strong> 1900 3013
        </p>

        <p style="color: #000;">
            <img src="https://cdn-icons-png.flaticon.com/512/561/561127.png" width="20" style="vertical-align: middle; margin-right: 8px;" />
            <strong>Email:</strong> info@suli.vn
        </p>

    </div>

    <div style="margin-top: 50px; padding: 20px; background: #fff; box-shadow: 0 0 10px rgba(0,0,0,0.1); border-radius: 5px;">
        <h3 style="margin-bottom: 10px;"><img src="https://cdn-icons-png.flaticon.com/512/906/906175.png" width="20" style="vertical-align: middle; margin-right: 8px;" /> Liên hệ</h3>
        <p style="color: #666;">Vui lòng điền đầy đủ thông tin theo yêu cầu để chúng tôi có thể hỗ trợ quý khách tốt nhất.</p>

        <form>
            <input type="text" placeholder="Họ và tên*" style="width: 100%; padding: 10px; margin-bottom: 15px; border: none; border-bottom: 1px solid #ccc;" />
            <input type="email" placeholder="Email*" style="width: 100%; padding: 10px; margin-bottom: 15px; border: none; border-bottom: 1px solid #ccc;" />
            <textarea placeholder="Nội dung" style="width: 100%; padding: 10px; height: 100px; border: none; border-bottom: 1px solid #ccc; resize: none;"></textarea>
            <button type="submit" style="width: 100%; padding: 10px; background: linear-gradient(to right, #caa380, #d3b59b); border: none; color: #fff; font-weight: bold; border-radius: 20px; margin-top: 15px;">Gửi</button>
        </form>
    </div>
</div>

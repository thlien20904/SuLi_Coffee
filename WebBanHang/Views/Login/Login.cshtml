@{
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
    ViewBag.Title = "Login";
}

<div class="login-container">
    <h2>Sign In</h2>
    <p class="subtitle">Welcome to MyBeauty! Please login to continue.</p>
    <!-- THÔNG BÁO ĐĂNG KÝ THÀNH CÔNG -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @using (Html.BeginForm("Login", "Login", FormMethod.Post))
    {
        @Html.Raw(@"
        <div class='input-group'>
            <i class='fas fa-user'></i>
            <input type='text' name='username' placeholder='Username' required />
        </div>

     <div class=""input-group"">
    <i class=""fas fa-lock""></i>
    <input type=""password"" name=""password"" placeholder=""Password"" id=""password"" required />
    <i class=""fas fa-eye toggle-password"" onclick=""togglePassword()""></i>
</div>



        <div class='options'>
            <label>
                <input type='checkbox' name='remember' /> Remember Me
            </label>
            <a href='#'>Forgot Password?</a>
        </div>

        <input type='submit' class='btn-login' value='Sign In' />
        ")

        if (ViewBag.Message != null)
        {
            <p class="error">@ViewBag.Message</p>
        }
    }

    <div class="signup">
        Don't have an account? <a href="@Url.Action("Register", "Register")">Signup</a>

    </div>

    <div class="or-divider">OR</div>

    <button class="social-btn facebook">
        <i class="fab fa-facebook-f"></i> Connect with Facebook
    </button>

    <button class="social-btn google">
        <i class="fab fa-google"></i> Connect with Google
    </button>
</div>

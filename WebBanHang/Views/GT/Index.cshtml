@model IEnumerable<WebBanHang.Models.Food>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Banner Section with Bootstrap Carousel -->
<section class="banner">
    <div id="carouselBanner" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">
            <div class="carousel-item">
                <video autoplay muted loop class="d-block w-100 banner-video">
                    <source src="@Url.Content("~/video/vd7.mp4")" type="video/mp4" />
                    Your browser does not support the video tag.
                </video>
            </div>
            <!-- Slide 2: Video -->
            <div class="carousel-item">
                <video autoplay muted loop class="d-block w-100 banner-video">
                    <source src="@Url.Content("~/video/vd9.mp4")" type="video/mp4" />
                    Your browser does not support the video tag.
                </video>
            </div>
            <!-- Slide 1: Video -->
            <div class="carousel-item active">
                <video autoplay muted loop class="d-block w-100 banner-video">
                    <source src="@Url.Content("~/video/vd6.mp4")" type="video/mp4" />
                    Your browser does not support the video tag.
                </video>
            </div>

            <!-- Slide 2: Video -->
            <div class="carousel-item">
                <video autoplay muted loop class="d-block w-100 banner-video">
                    <source src="@Url.Content("~/video/vd10.mp4")" type="video/mp4" />
                    Your browser does not support the video tag.
                </video>
            </div>

        </div>
    </div>


    <!-- Controls -->
    <button class="carousel-control-prev" type="button" data-bs-target="#carouselBanner" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#carouselBanner" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
    </button>
    </div>
</section>
<section class="about" ;text-align: center;>
    <h2>SULI VÀ NHỮNG ĐIỀU KHÁC BIỆT</h2>
    <div class="about-content">
        <!-- Phần Câu chuyện thương hiệu -->
        <div class="about-text">
            <h3>CÂU CHUYỆN THƯƠNG HIỆU</h3>
            <p>
                Nốt Hương Đặc Sản -
                SuLi luôn trân quý, nâng niu những giá trị Nguyên Bản ở mỗi vùng đất mà chúng tôi đi qua, nơi tâm hồn được đồng điệu với thiên nhiên, với nỗi vất vả nhọc nhằn của người nông dân; cảm nhận được hết thảy những tầng hương ẩn sâu trong từng nguyên liệu.<br><br>
                Một chặng đường dài đang chờ phía trước, SuLi đã sẵn sàng viết tiếp câu chuyện Nốt Hương Đặc Sản – Nguyên Bản – Thủ Công đầy cảm hứng và càng tự hào hơn khi được mang sứ mệnh: “Đánh thức những nốt hương đặc sản của nông sản Việt Nam”.
            </p>
        </div>

        <!-- Phần Nguyên liệu đặc sản + ảnh -->
        <div class="about-image">
            <img src="@Url.Content("~/images/cafe1.png")" alt="About Image" />
        </div>
        <div class="about-text">
            <h3>NGUYÊN LIỆU ĐẶC SẢN</h3>
            <p>
                Trà Ô Long đặc sản tại SuLi còn được ươm trồng với phương pháp chăm bón hữu cơ, hoàn toàn với trứng gà, đậu nành và thu hái thủ công để có được những búp trà tươi và non nhất, tạo nên điểm khác biệt mạnh mẽ so với các thương hiệu khác.<br><br>
                Có thể nói, dòng trà đặc sản của SuLi luôn giữ được hương vị thơm ngon nguyên bản nhất và được nhiều người biết đến như một nguồn nguyên liệu tinh hoa của Đà Lạt.
            </p>
        </div>
    </div>
</section>

<!-- Thành tựu nổi bật -->
<section class="achievements" ;text-align: center;>
    <h2>Thành tựu nổi bật và đáng tự hào</h2>
    <div class="achievements-container">
        <div class="achievement-item">
            <i class="fas fa-eye"></i>
            <h3>210.000+</h3>
            <p>Sản phẩm được bán ra trên thị trường trong vòng 5 tháng kinh doanh trong tình hình dịch bệnh căng thẳng</p>
        </div>
        <div class="achievement-item">
            <i class="fas fa-store"></i>
            <h3>5836</h3>
            <p>Lần được nhắc đến trên Facebook và Instagram trong vòng 4 tháng (từ 15/03/2021 đến 15/07/2021) (theo Sprout Social)</p>
        </div>
        <div class="achievement-item">
            <i class="fas fa-gem"></i>
            <h3>98%</h3>
            <p>Khách hàng hài lòng về chất lượng sản phẩm và dịch vụ của SuLi (theo đánh giá trên Baemin và Shopee Fresh)</p>
        </div>
    </div>
</section>

<!-- Dấu ấn hành trình -->
<section class="timeline">
    <h2 class="text-center">Những dấu ấn trong hành trình của chúng tôi</h2>
    <div class="timeline-container">
        <div class="timeline-item">
            <div class="timeline-content">
                <span class="date">8/2020</span>
                <img src="@Url.Content("~/images/gt.png")" alt="Milestone 1">
                <h3>SuLi và những bước đi đầu tiên</h3>
                <p>Thương hiệu SuLi được đăng ký bảo hộ độc quyền tại Việt Nam</p>
            </div>
        </div>
        <div class="timeline-item">
            <div class="timeline-content">
                <span class="date">8/3/2021</span>
                <img src="@Url.Content("~/images/gt2.png")" alt="Milestone 2">
                <h3>Ra mắt thị trường</h3>
                <p>SuLi chính thức xuất hiện trên thị trường với cửa hàng đầu tiên tại Phạm Ngọc Thạch</p>
            </div>
        </div>
        <div class="timeline-item">
            <div class="timeline-content">
                <span class="date">16/3/2021</span>
                <img src="@Url.Content("~/images/gt3.png")" alt="Milestone 3">
                <h3>Phủ sóng các kênh bán hàng online</h3>
                <p>Lần lượt xuất hiện trên các ứng dụng giao hàng hàng đầu là Baemin và Shopee Fresh</p>
            </div>
        </div>
    </div>
</section>

<h3 class="text-center" style="display: block; width: 100%; margin-bottom: 20px;">🔥 CÁC DÒNG SẢN PHẨM  NỔI BẬT 🔥</h3>
<section class="best-sellers container mt-4">

    <div id="carouselBestSellers" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">
            @if (ViewBag.BanChay is List<WebBanHang.Models.BanChayModel> bestSellers && bestSellers.Any())
            {

                int itemsPerSlide = 4; // Hiển thị 4 sản phẩm mỗi lần
                int totalItems = bestSellers.Count;
                int slideIndex = 0;

                for (int i = 0; i < totalItems; i += itemsPerSlide)
                {
                    var itemsInThisSlide = bestSellers.Skip(i).Take(itemsPerSlide).ToList();

                    <div class="carousel-item @(slideIndex == 0 ? "active" : "")">
                        <div class="row">
                            @foreach (var item in itemsInThisSlide)
                            {
                                <div class="col-md-3">
                                    <div class="product-card">
                                        <img id="ImagePreview" src="@(!string.IsNullOrEmpty(item.ImageUrl) ? item.ImageUrl : Url.Content("~/Images/no-image.png"))"
                                             style="max-width: 100%; height: auto; display: block;" />

                                        <h5>@item.FoodName</h5>
                                        <p class="price" style="color: #C19A6B; font-weight: bold;">@item.Price.ToString("N0")đ</p>

                                        <p class="sold">Đã bán: @item.TotalSold</p>
                                        <a href="@Url.Action("ChiTiet", "SanPham", new { id = item.FoodId })" class="btn-buy">
                                            Xem chi tiết
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    slideIndex++;
                }
            }
            else
            {
                <p class="text-center text-danger">Không có dữ liệu</p>
            }
        </div>

        <!-- Controls -->
        <button class="carousel-control-prev" type="button" data-bs-target="#carouselBestSellers" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#carouselBestSellers" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>
</section>




<style>

    /* Banner */
    .banner {
        width: 100%;
        height: 600px;
        margin: 0 auto;
        overflow: hidden;
        position: relative;
    }

    .banner-video,
    .banner-image {
        width: 90%;
        height: 500px;
        object-fit: cover;
        transition: transform 0.5s ease;
    }

    .banner:hover .banner-video,
    .banner:hover .banner-image {
        /*    transform: scale(1.05);*/
    }

    /* Căn giữa danh sách sản phẩm */
    .product-list {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 20px;
    }

    .carousel-inner {
        padding-bottom: 20px; /* Giảm khoảng cách dư thừa */
        min-height: 400px;
    }

    .col-md-3 {
        padding-bottom: 20px; /* Tạo khoảng trống dưới */
    }

    .carousel {
        overflow: visible !important;
    }

    /* Card sản phẩm */
    .product-card {
        background-color: #fff;
        border: 1px solid #ddd;
        padding: 15px;
        width: 260px;
        height: 100%;
        border-radius: 10px;
        transition: all 0.3s ease-in-out;
        display: flex;
        flex-direction: column;
        align-items: flex-start; /* Căn trái toàn bộ nội dung */
        text-align: left; /* Chữ căn trái */
        align-items: flex-start; /* Căn trái toàn bộ nội dung */
        text-align: left; /* Chữ căn trái */
        box-shadow: 2px 2px 10px rgba(0, 0, 0, 0.1);
    }


        .product-card:hover {
            transform: scale(1.05);
            box-shadow: 4px 4px 15px rgba(0, 0, 0, 0.15);
        }

        .product-card img {
            width: 100%;
            height: 160px;
            object-fit: cover;
            border-radius: 10px;
        }

        .product-card h5 {
            font-size: 16px;
            color: #333;
            margin: 10px 0 5px;
        }

        .product-card .price {
            color: #C19A6B !important; /* Màu trùng với nền nút "Xem chi tiết" */
            font-weight: bold;
            font-size: 16px;
            margin: 5px 0;
        }

        .product-card .sold {
            color: #666;
            font-size: 14px;
            margin: 5px 0;
        }

        .product-card .btn-buy {
            background: #e5d1c0;
            color: #3a3a3a;
            border: none;
            padding: 8px 25px;
            font-weight: bold;
            cursor: pointer;
            transition: background 0.3s;
            border-radius: 5px;
            font-size: 13px;
            text-transform: uppercase;
            margin-top: auto;
        }

            .product-card .btn-buy:hover {
                background: #d3b49e;
            }

    .price {
        color: #C19A6B; /* Thay bằng mã màu của nền nút "Xem chi tiết" */
        font-weight: bold;
    }
</style>